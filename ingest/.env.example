# 接收端的环境变量（VPS 上和网关共用 deploy/vps/.env，下面几项由 docker-compose 固定传入）
NOTION_TOKEN=                      # 和 Gateway 用同一个 token
ANTHROPIC_API_KEY=                 # 拍照识别用（和 Gateway 同一把）
INGEST_TOKEN=                      # openssl rand -hex 16；手机快捷指令 / Health Auto Export 请求头 Authorization: Bearer <这个>
NOTION_DAILY_DATA_SOURCE_ID=9ffc0fca-38de-4711-a83d-d0046349e249   # 「每日指标 Daily」
NOTION_LOG_DATA_SOURCE_ID=17dca1b3-1334-4082-ae85-8cb1de5e5978     # 「记录 Log」
NOTION_REPORT_DATA_SOURCE_ID=94401eb4-de13-4cb8-9cc4-c840fc66fdb8  # 「报告 Report」；不配就不出日报
REPORT_TIME=21:30                  # 每天几点自动出日报（TZ 的本地时间）
REPORT_MODEL=                      # 写点评用的模型，空 = 同 VISION_MODEL
BARK_KEY=                          # 可选：iPhone 上 Bark app 的 device key，配了日报 / 带血黑便会推到手机
BARK_SERVER=https://api.day.app    # 可选：自建 bark-server 时改
VISION_MODEL=claude-sonnet-5-5     # 看图用的模型
PHOTO_DIR=/data/photos             # 原图 + JSONL 流水落盘目录（持久卷）
TZ=Asia/Shanghai
