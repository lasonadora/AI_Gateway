# 复制到 Railway 的 Variables 里。不要提交真实值。

# 必填
OPENCLAW_GATEWAY_TOKEN=        # 自己生成一串随机字符：openssl rand -hex 24
ANTHROPIC_API_KEY=             # console.anthropic.com
NOTION_TOKEN=                  # Notion integration 的 token，并把「健康 Agent」页面分享给它

# 推荐
OPENCLAW_TZ=Asia/Shanghai      # 回美国后改成 America/Los_Angeles
OPENCLAW_PUBLIC_ORIGIN=        # 部署后 Railway 给的域名，如 https://xxx.up.railway.app

# 模型（可不填，有默认值）
OPENCLAW_PRIMARY_MODEL=anthropic/claude-sonnet-5-5
OPENCLAW_FALLBACK_MODEL=anthropic/claude-haiku-5-5
OPENCLAW_UTILITY_MODEL=anthropic/claude-haiku-5-5
